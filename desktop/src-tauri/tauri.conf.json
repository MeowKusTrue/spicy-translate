{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spicy Translate",
  "version": "1.0.2",
  "identifier": "dev.spicytranslate.editor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/spicy-server"
    ],
    "resources": {
      "../../dist/index.html": "web/index.html",
      "../../experiments/auto-align/align.py": "auto-align/align.py",
      "../../experiments/auto-align/requirements.txt": "auto-align/requirements.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  }
}
